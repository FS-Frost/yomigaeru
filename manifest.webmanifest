{
	"name": "Yomigaeru — Japonés",
	"short_name": "Yomigaeru",
	"description": "Repaso espaciado de japonés con IA, offline-first.",
	"start_url": ".",
	"scope": ".",
	"display": "standalone",
	"background_color": "#f8fafc",
	"theme_color": "#0f172a",
	"lang": "es",
	"icons": [
		{ "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
		{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
		{ "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
		{ "src": "icons/icon-maskable.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "maskable" },
		{ "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
	],
	"shortcuts": [
		{ "name": "Estudiar", "short_name": "Estudiar", "description": "Repasos y nuevas de hoy", "url": "estudio", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
		{ "name": "Foto a tarjetas", "short_name": "Foto", "description": "Crear tarjetas desde una foto", "url": "crear?camara=1", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
		{ "name": "Crear tarjeta", "short_name": "Crear", "description": "Crear tarjetas desde una palabra o un texto", "url": "crear", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
	],
	"share_target": {
		"action": "compartir",
		"method": "POST",
		"enctype": "multipart/form-data",
		"params": {
			"title": "title",
			"text": "text",
			"url": "url",
			"files": [
				{
					"name": "files",
					"accept": ["image/*", "text/plain", ".txt", "text/tab-separated-values", ".tsv", "text/csv", ".csv", "application/json", ".json", ".apkg"]
				}
			]
		}
	},
	"file_handlers": [
		{
			"action": "compartir",
			"accept": {
				"image/*": [".png", ".jpg", ".jpeg", ".webp"],
				"application/json": [".json"],
				"text/tab-separated-values": [".tsv"],
				"text/csv": [".csv"],
				"text/plain": [".txt"],
				"application/octet-stream": [".apkg"]
			}
		}
	]
}
